// Synkopa Keys: Grand Piano.
// Salamander Grand Piano V3 (Yamaha C5) by Alexander Holm, CC-BY-3.0.
// https://github.com/sfzinstruments/SalamanderGrandPiano
// Mapping by Synkopa: 4 of the 16 recorded dynamics (layers 1, 6, 11, 16), every minor
// third from A0 to C8, plus the 88 key-release recordings. Inside its velocity band a layer
// is levelled by (velocity / the velocity it was played at)^k, with k measured from the
// level step to the next layer (RMS of the first 0.5 s, mean over the 30 notes), so the level
// is continuous across layer boundaries.
// Keys above D#6 have no dampers on a grand: they ring on after the key is let go.

<global> ampeg_release=0.5

<group> lovel=1 hivel=25 amp_velcurve_1=0.0769 amp_velcurve_13=1 amp_velcurve_25=1.9231
<region> sample=A0v1.flac lokey=21 hikey=22 pitch_keycenter=21
